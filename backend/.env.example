# ================================================================
# Sahayak AI - Backend Environment Configuration
# ================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# MongoDB Connection (Atlas Key Placeholder - replace with your Atlas URI)
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.mongodb.net/sahayak_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=sahayak_ai

# Gnani.ai API Credentials
# Official base URL: https://api.vachana.ai
GNANI_API_KEY=YOUR_GNANI_API_KEY_HERE

# Prisma (Speech-to-Text)
GNANI_PRISMA_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0

# Timbre (Text-to-Speech)
GNANI_TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_DEFAULT_VOICE=Nalini

# Evon (Reasoning & Conversational Intelligence)
GNANI_EVON_URL=https://api.vachana.ai/v1/chat/completions
GNANI_EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# OCR Configuration (Optional path to tesseract.exe if not in PATH)
# Example for Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
